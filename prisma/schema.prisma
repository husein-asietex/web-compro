generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  STAFF
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(STAFF)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  revisions    Revision[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model SiteSetting {
  id                String   @id @default("site")
  catalogUrl        String   @default("https://e-catalog.asietex.web.id")
  catalogOn         Boolean  @default(true)
  catalogLabelEn    String   @default("Explore e-catalog")
  catalogLabelId    String   @default("Buka e-catalog")
  catalogLabelPt    String   @default("Ver e-catalog")
  catalogPlacements Json     @default("[\"home\", \"product\", \"footer\"]")
  catalogOpenNewTab Boolean  @default(true)
  draft             Json?
  updatedAt         DateTime @updatedAt

  @@map("site_setting")
}

model ContentCollection {
  key       String        @id
  data      Json
  draft     Json?
  status    ContentStatus @default(DRAFT)
  updatedAt DateTime      @updatedAt

  @@map("content_collection")
}

model Page {
  id           String        @id @default(cuid())
  slug         String        @unique
  status       ContentStatus @default(DRAFT)
  draft        Json?
  translations Translation[]
  media        MediaAsset[]
  updatedAt    DateTime      @updatedAt

  @@map("page")
}

model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  order        Int           @unique
  capacity     String?       @db.VarChar(500)
  products     Json          @default("[]")
  machinery    String?       @db.Text
  videoEn      String?       @db.Text
  videoId      String?       @db.Text
  videoPt      String?       @db.Text
  gallery      Json          @default("[]")
  status       ContentStatus @default(DRAFT)
  draft        Json?
  translations Translation[]
  media        MediaAsset[]
  updatedAt    DateTime      @updatedAt

  @@map("product")
}

model Translation {
  id        String   @id @default(cuid())
  locale    String
  title     String   @db.Text
  body      String   @db.Text
  capacity  String?  @db.VarChar(500)
  products  Json?
  machinery String?  @db.Text
  pageId    String?
  productId String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@unique([productId, locale])
  @@map("translation")
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String   @db.Text
  altEn     String   @db.Text
  altId     String   @db.Text
  altPt     String   @db.Text
  credit    String?  @db.Text
  approved  Boolean  @default(false)
  pageId    String?
  productId String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@map("media_asset")
}

model Revision {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("revision")
}
