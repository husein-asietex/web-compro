generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(STAFF)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  revisions    Revision[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  id                 String   @id @default("site")
  catalogUrl         String   @default("https://e-catalog.asietex.web.id")
  catalogOn          Boolean  @default(true)
  catalogLabelEn     String   @default("Explore e-catalog")
  catalogLabelId     String   @default("Buka e-catalog")
  catalogLabelPt     String   @default("Ver e-catalog")
  catalogPlacements  String[] @default(["home", "about", "products", "division", "network", "career", "contact", "footer"])
  catalogOpenNewTab  Boolean  @default(true)
  draft              Json?
  updatedAt          DateTime @updatedAt
}

model Page {
  id           String        @id @default(cuid())
  slug         String        @unique
  status       ContentStatus @default(DRAFT)
  draft        Json?
  translations Translation[]
  media        MediaAsset[]
  updatedAt    DateTime      @updatedAt
}

model Division {
  id           String        @id @default(cuid())
  slug         String        @unique
  order        Int           @unique
  capacity     String?
  products     String[]      @default([])
  machinery    String?
  videoEn      String?
  videoId      String?
  videoPt      String?
  gallery      String[]      @default([])
  status       ContentStatus @default(DRAFT)
  draft        Json?
  translations Translation[]
  media        MediaAsset[]
  updatedAt    DateTime      @updatedAt
}

model Translation {
  id         String    @id @default(cuid())
  locale     String
  title      String
  body       String
  pageId     String?
  divisionId String?
  page       Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@unique([divisionId, locale])
}

model MediaAsset {
  id         String    @id @default(cuid())
  url        String
  altEn      String
  altId      String
  altPt      String
  credit     String?
  approved   Boolean   @default(false)
  pageId     String?
  divisionId String?
  page       Page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
}

model NetworkLocation {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  country   String
  city      String
  address   String?
  kind      String
  order     Int           @default(0)
  status    ContentStatus @default(DRAFT)
  draft     Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Revision {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
